# Turnstile configuration.
#
# Copy this file to .env and adjust for your setup:
#     cp .env.example .env
#
# Turnstile loads .env on startup. Real environment variables take precedence
# over anything set here. Every value below is optional and shown with its
# default; uncomment and change only what you need.

# Address the server listens on. Serves the Connect API (gRPC, gRPC-Web, and
# Connect HTTP/JSON on one port), the management UI at /ui/, /health, and (when
# enabled) /metrics.
# LISTEN_ADDR=:8080

# Path to the SQLite database file.
# DB_PATH=turnstile.db

# Days of audit log to keep. 0 keeps entries forever.
# AUDIT_RETENTION_DAYS=365

# Expose Prometheus metrics at /metrics (unauthenticated, like /health).
# Defaults to on; set to false/0/off/no to disable.
# METRICS_ENABLED=true

# Guarding the host-facing RPCs (Check/Authenticate). These RPCs are
# open at the application layer — there is no service credential. Restrict who
# can reach them with optional mTLS and/or network isolation.
#
#   TLS / mTLS. Set TLS_CERT_FILE + TLS_KEY_FILE to serve HTTPS; also set
#   TLS_CLIENT_CA_FILE to require and verify client certificates (mTLS) — each
#   host then presents a client cert signed by that CA.
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# TLS_CLIENT_CA_FILE=
#
#   Refuse to start unless TLS is configured (guards against running plaintext in
#   production). Does not itself enable TLS — set the cert/key above.
# TLS_REQUIRED=false
