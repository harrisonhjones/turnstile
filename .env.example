# Turnstile configuration.
#
# Copy this file to .env and adjust for your setup:
#     cp .env.example .env
#
# Turnstile loads .env on startup. Real environment variables take precedence
# over anything set here. Every value below is optional and shown with its
# default; uncomment and change only what you need.

# Address the server listens on. Serves the Connect API (gRPC, gRPC-Web, and
# Connect HTTP/JSON on one port), the management UI at /ui/, /health, and (when
# enabled) /metrics.
# LISTEN_ADDR=:8080

# Path to the SQLite database file.
# DB_PATH=turnstile.db

# Days of audit log to keep. 0 keeps entries forever.
# AUDIT_RETENTION_DAYS=365

# Expose Prometheus metrics at /metrics (unauthenticated, like /health).
# Defaults to on; set to false/0/off/no to disable.
# METRICS_ENABLED=true

# Host -> Turnstile service authentication (guarding the host-facing RPCs
# Check/Authenticate/ReportAudit). Choose ONE:
#
#   (a) Shared service credential. When set, callers must send it as
#       "Authorization: Bearer <value>" metadata on those RPCs. Unset = open
#       (rely on mTLS or network isolation instead).
# SERVICE_CREDENTIAL=
#
#   (b) mTLS. Set TLS_CERT_FILE + TLS_KEY_FILE to serve HTTPS; add
#       TLS_CLIENT_CA_FILE to require and verify client certificates.
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# TLS_CLIENT_CA_FILE=
