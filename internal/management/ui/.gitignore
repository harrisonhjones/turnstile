# Logs
logs
*.log
npm-debug.log*

node_modules
# The build output is generated by `mage build:ui` and gitignored. Only an empty
# .gitkeep is tracked, so the Go package's go:embed of ui/dist compiles without a
# Node build (it then serves a placeholder page). This keeps the generated
# index.html/assets out of git entirely — no churn from local builds.
dist/*
!dist/.gitkeep
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.sw?
