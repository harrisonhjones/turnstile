# Keep the build context small and reproducible.
.git
.github
**/node_modules
# The console is built fresh in the image's Node stage; never copy a local
# build (it would make images non-reproducible / depend on working-tree state).
internal/management/ui/dist
*.db
*.db-wal
*.db-shm
.env
/turnstile
/tmp
tmp/
build-errors.log
